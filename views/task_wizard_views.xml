<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Глобальная кнопка на Канбан-доске задач внутри проекта -->
    <record id="view_task_kanban_inherit" model="ir.ui.view">
        <field name="name">project.task.kanban.inherit</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_kanban"/>
        <field name="arch" type="xml">
            <!-- 
                Согласно документации Odoo 20.0, тег header внутри kanban с display="always" 
                выводит кнопку в глобальную Control Panel этой доски (рядом с кнопкой "New").
            -->
            <xpath expr="//kanban" position="inside">
                <header>
                    <button name="open_custom_wizard" string="Открыть Wizard" type="object" class="btn btn-primary" display="always"/>
                </header>
            </xpath>
        </field>
    </record>

    <!-- 2. Кнопка внутри формы открытой задачи (уже работает) -->
    <record id="view_task_form_inherit" model="ir.ui.view">
        <field name="name">project.task.form.inherit</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="open_custom_wizard" string="Вызвать Мастер" type="object" class="btn btn-primary"/>
            </xpath>
        </field>
    </record>
</odoo>